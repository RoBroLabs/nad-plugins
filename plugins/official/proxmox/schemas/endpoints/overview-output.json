{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proxmox partial overview response",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodeCount", "onlineNodes", "guestCount", "runningGuests", "storageCount", "failedTasks", "cpuPercent", "memoryUsed", "memoryTotal", "memoryPercent", "storageUsed", "storageTotal", "storagePercent", "statusLabel", "statusTone", "degradedSections", "refreshedAt", "nodes", "guests", "storage", "tasks", "sections"],
  "properties": {
    "nodeCount": { "type": "integer", "minimum": 0, "maximum": 32 },
    "onlineNodes": { "type": "integer", "minimum": 0, "maximum": 32 },
    "guestCount": { "type": "integer", "minimum": 0, "maximum": 256 },
    "runningGuests": { "type": "integer", "minimum": 0, "maximum": 256 },
    "storageCount": { "type": "integer", "minimum": 0, "maximum": 256 },
    "failedTasks": { "type": "integer", "minimum": 0, "maximum": 50 },
    "cpuPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "memoryUsed": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "memoryTotal": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "memoryPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "storageUsed": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "storageTotal": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "storagePercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "statusLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
    "statusTone": { "enum": ["ok", "warning", "critical"] },
    "degradedSections": { "type": "integer", "minimum": 0, "maximum": 4 },
    "refreshedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "nodes": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": true } },
    "guests": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": true } },
    "storage": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": true } },
    "tasks": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": true } },
    "sections": { "type": "object", "additionalProperties": true }
  }
}
