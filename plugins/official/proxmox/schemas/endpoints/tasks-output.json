{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proxmox recent task response",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks", "refreshedAt"],
  "properties": {
    "tasks": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": true } },
    "refreshedAt": { "type": "string", "minLength": 20, "maxLength": 40 }
  }
}
