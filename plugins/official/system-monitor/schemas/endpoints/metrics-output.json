{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System Monitor metrics response",
  "type": "object",
  "additionalProperties": false,
  "required": ["totalHosts", "onlineHosts", "offlineHosts", "status", "statusTone", "checkMethod", "checkMethodLabel", "hosts"],
  "properties": {
    "totalHosts": { "type": "integer", "minimum": 0 },
    "onlineHosts": { "type": "integer", "minimum": 0 },
    "offlineHosts": { "type": "integer", "minimum": 0 },
    "status": { "type": "string" },
    "statusTone": { "enum": ["ok", "warning", "critical"] },
    "checkMethod": { "enum": ["node_exporter", "http"] },
    "checkMethodLabel": { "type": "string" },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "address", "status"],
        "properties": {
          "name": { "type": "string" },
          "address": { "type": "string" },
          "status": { "enum": ["online", "offline", "degraded"] },
          "uptimeSeconds": { "type": ["number", "null"] },
          "cpuPercent": { "type": ["number", "null"] },
          "memoryPercent": { "type": ["number", "null"] },
          "diskPercent": { "type": ["number", "null"] },
          "error": { "type": "string" }
        }
      }
    }
  }
}
