{
  "name": "@nad/module-system-monitor",
  "version": "1.0.3",
  "private": true,
  "description": "Official NAD System Monitor Module.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "nad-module check .",
    "preview": "pnpm build && nad-module dev .",
