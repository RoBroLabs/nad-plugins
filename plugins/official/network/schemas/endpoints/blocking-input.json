{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Network DNS blocking request",
  "type": "object",
  "additionalProperties": false,
  "required": ["action"],
  "properties": {
    "action": { "enum": ["enable", "disable"] },
    "durationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    }
  }
}
