{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Network DNS blocking status response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blockingStatus",
    "statusLabel",
    "statusTone",
    "configuredInstances",
    "availableInstances",
    "instances",
    "refreshedAt"
  ],
  "properties": {
    "blockingStatus": { "enum": ["enabled", "disabled", "mixed", "unknown"] },
    "statusLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
    "statusTone": { "enum": ["ok", "warning", "critical"] },
    "configuredInstances": { "type": "integer", "minimum": 1, "maximum": 2 },
    "availableInstances": { "type": "integer", "minimum": 0, "maximum": 2 },
    "instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "available", "blockingStatus"],
        "properties": {
          "id": { "enum": ["primary", "secondary"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "available": { "type": "boolean" },
          "blockingStatus": { "enum": ["enabled", "disabled", "unknown"] },
          "error": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "refreshedAt": { "type": "string", "minLength": 20, "maxLength": 40 }
  }
}
