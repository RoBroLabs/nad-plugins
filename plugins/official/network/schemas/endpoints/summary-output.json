{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Network summary response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "totalQueries",
    "blockedQueries",
    "blockPercentage",
    "domainsOnBlocklist",
    "blockingStatus",
    "statusLabel",
    "statusTone",
    "configuredInstances",
    "availableInstances",
    "unavailableInstances",
    "refreshedAt"
  ],
  "properties": {
    "totalQueries": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "blockedQueries": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "blockPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "domainsOnBlocklist": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "blockingStatus": { "enum": ["enabled", "disabled", "mixed", "unknown"] },
    "statusLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
    "statusTone": { "enum": ["ok", "warning", "critical"] },
    "configuredInstances": { "type": "integer", "minimum": 1, "maximum": 2 },
    "availableInstances": { "type": "integer", "minimum": 0, "maximum": 2 },
    "unavailableInstances": { "type": "integer", "minimum": 0, "maximum": 2 },
    "refreshedAt": { "type": "string", "minLength": 20, "maxLength": 40 }
  }
}
