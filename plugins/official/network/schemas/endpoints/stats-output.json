{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Network DNS statistics response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "totalQueries",
    "blockedQueries",
    "blockPercentage",
    "domainsOnBlocklist",
    "uniqueClients",
    "queriesForwarded",
    "queriesCached",
    "blockingStatus",
    "statusLabel",
    "statusTone",
    "configuredInstances",
    "availableInstances",
    "instances",
    "unavailableInstances",
    "refreshedAt"
  ],
  "properties": {
    "totalQueries": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "blockedQueries": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "blockPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "domainsOnBlocklist": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "uniqueClients": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "queriesForwarded": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "queriesCached": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
    "blockingStatus": { "enum": ["enabled", "disabled", "mixed", "unknown"] },
    "statusLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
    "statusTone": { "enum": ["ok", "warning", "critical"] },
    "configuredInstances": { "type": "integer", "minimum": 1, "maximum": 2 },
    "availableInstances": { "type": "integer", "minimum": 0, "maximum": 2 },
    "instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "available",
          "totalQueries",
          "blockedQueries",
          "blockPercentage",
          "domainsOnBlocklist",
          "uniqueClients",
          "queriesForwarded",
          "queriesCached",
          "blockingStatus"
        ],
        "properties": {
          "id": { "enum": ["primary", "secondary"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "available": { "type": "boolean" },
          "totalQueries": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
          "blockedQueries": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
          "blockPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
          "domainsOnBlocklist": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
          "uniqueClients": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
          "queriesForwarded": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
          "queriesCached": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
          "blockingStatus": { "enum": ["enabled", "disabled", "unknown"] },
          "error": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "unavailableInstances": {
      "type": "array",
      "maxItems": 2,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 },
      "uniqueItems": true
    },
    "refreshedAt": { "type": "string", "minLength": 20, "maxLength": 40 }
  }
}
