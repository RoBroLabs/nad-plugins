{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unraid overview response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statusLabel",
    "statusTone",
    "hostname",
    "unraidVersion",
    "apiVersion",
    "kernelVersion",
    "uptimeStartedAt",
    "uptimeSeconds",
    "cpuBrand",
    "cpuCores",
    "cpuThreads",
    "cpuUsagePercent",
    "memoryTotalBytes",
    "memoryUsedBytes",
    "memoryAvailableBytes",
    "memoryUsagePercent",
    "arrayState",
    "capacity",
    "parity",
    "dockerTotal",
    "dockerRunning",
    "dockerPaused",
    "vmTotal",
    "vmRunning",
    "vmPaused",
    "partial",
    "errors",
    "refreshedAt"
  ],
  "properties": {
    "statusLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "statusTone": {
      "enum": [
        "ok",
        "warning",
        "critical"
      ]
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "unraidVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "apiVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "kernelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "uptimeStartedAt": {
      "type": "string",
      "maxLength": 64
    },
    "uptimeSeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cpuBrand": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "cpuCores": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "cpuThreads": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8192
    },
    "cpuUsagePercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "memoryTotalBytes": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "memoryUsedBytes": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "memoryAvailableBytes": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "memoryUsagePercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "arrayState": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalBytes",
        "usedBytes",
        "freeBytes",
        "usagePercent"
      ],
      "properties": {
        "totalBytes": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usedBytes": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "freeBytes": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usagePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "progressPercent",
        "errors",
        "running",
        "paused"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "progressPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "errors": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "running": {
          "type": "boolean"
        },
        "paused": {
          "type": "boolean"
        }
      }
    },
    "dockerTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "dockerRunning": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "dockerPaused": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "vmTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "vmRunning": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "vmPaused": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "partial": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "message"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "refreshedAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    }
  }
}
