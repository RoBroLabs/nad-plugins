{
  "schemaVersion": 1,
  "widgets": [
    {
      "id": "summary",
      "name": "Summary",
      "description": "Read-only summary generated by the scaffold.",
      "defaultSize": { "w": 4, "h": 3 },
      "minSize": { "w": 3, "h": 2 },
      "maxSize": { "w": 6, "h": 4 },
      "requiredConfig": ["headline", "status_message"],
      "source": {
        "endpoint": "summary",
        "refreshIntervalMs": 30000
      },
      "body": [
        {
          "type": "section",
          "body": [
            { "type": "status", "label": "State", "valuePath": "statusMessage", "tonePath": "statusTone" },
            {
              "type": "keyValue",
              "items": [
                { "label": "Mode", "valuePath": "mode" },
                { "label": "Publisher", "valuePath": "publisher" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
