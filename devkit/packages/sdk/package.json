{
  "name": "@nad/sdk",
  "version": "0.3.0",
  "description": "NAD external Module contract types, validation, and package helpers.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20.20.0 <21 || >=22.22.0 <23"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.18.0"
  }
}
