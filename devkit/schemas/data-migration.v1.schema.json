{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nad.robrolabs.com/module/data-migration.v1.schema.json",
  "title": "ModuleDataMigrationDocument",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 3,
  "required": ["fromVersion", "toVersion"],
  "properties": {
    "fromVersion": { "$ref": "#/$defs/semver" },
    "toVersion": { "$ref": "#/$defs/semver" },
    "config": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/operation" }
    },
    "storage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "from", "to"],
          "properties": {
            "op": { "const": "rename" },
            "from": { "$ref": "#/$defs/key" },
            "to": { "$ref": "#/$defs/key" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "key", "value"],
          "properties": {
            "op": { "const": "setDefault" },
            "key": { "$ref": "#/$defs/key" },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "key"],
          "properties": {
            "op": { "const": "delete" },
            "key": { "$ref": "#/$defs/key" }
          }
        }
      ]
    }
  }
}
